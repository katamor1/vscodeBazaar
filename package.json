{
  "name": "vscode-bazaar",
  "displayName": "Bazaar SCM",
  "description": "Visual Studio Code で Bazaar の状態、履歴、グラフ、blame、ブランチ、タグ、シェルブ、競合、差分を扱う SCM 拡張です。",
  "version": "0.2.11",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "workspaceContains:.bzr",
    "onCommand:bazaar.refresh",
    "onView:bazaarExplore",
    "onView:bazaarHistory",
    "onView:bazaarBranches",
    "onView:bazaarTags",
    "onView:bazaarShelves",
    "onView:bazaarGraph"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Bazaar",
      "properties": {
        "bazaar.cliPath": {
          "type": "string",
          "default": "bzr",
          "description": "この拡張が使用する Bazaar コマンドライン実行ファイルのパス。"
        },
        "bazaar.history.limit": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "履歴ビューとグラフビューで読み込む Bazaar リビジョンの最大数。"
        },
        "bazaar.history.includeMerged": {
          "type": "boolean",
          "default": true,
          "description": "Bazaar の履歴ビューとグラフビューにマージ済みリビジョンを含めます。"
        },
        "bazaar.unknown.expandDirectories": {
          "type": "boolean",
          "default": true,
          "description": "未追跡の Bazaar ディレクトリをソース管理ビューでファイル項目に展開します。"
        },
        "bazaar.autoRefresh.enabled": {
          "type": "boolean",
          "default": true,
          "description": "ワークスペース内のファイル変更後に Bazaar 状態を自動更新します。"
        },
        "bazaar.autoRefresh.debounceMs": {
          "type": "number",
          "default": 750,
          "minimum": 100,
          "description": "Bazaar 自動更新のデバウンス時間をミリ秒で指定します。"
        },
        "bazaar.blame.enabledFormat": {
          "type": "string",
          "default": "revAuthorDate",
          "enum": [
            "revAuthorDate",
            "revAuthor"
          ],
          "description": "カーソル行または選択範囲に表示する Bazaar blame 装飾の行末形式。"
        },
        "bazaar.dangerousOperations.requireTypedConfirmation": {
          "type": "boolean",
          "default": true,
          "description": "clean-tree、uncommit、break-lock、競合の一括操作など破壊的な Bazaar 操作の前に、正確な入力確認を要求します。"
        },
        "bazaar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "このワークスペースで Bazaar 拡張機能を有効にします。無効時は専用ビューと操作を隠します。"
        },
        "bazaar.command.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Bazaar コマンドのタイムアウト時間をミリ秒で指定します。"
        },
        "bazaar.trace.mode": {
          "type": "string",
          "default": "summary",
          "enum": [
            "off",
            "summary",
            "truncated",
            "full"
          ],
          "description": "Bazaar コマンドトレースの出力方式。summary は本文を省略し、truncated は一部のみ出力し、full は全文出力します。"
        },
        "bazaar.trace.maxOutputChars": {
          "type": "number",
          "default": 4000,
          "minimum": 0,
          "description": "truncated モードまたはエラー出力で Bazaar 出力チャンネルに出す最大文字数。"
        },
        "bazaar.trace.maxOutputLines": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "description": "truncated モードまたはエラー出力で Bazaar 出力チャンネルに出す最大行数。"
        },
        "bazaar.trace.omitLargeCommandOutput": {
          "type": "boolean",
          "default": true,
          "description": "log、diff、annotate、cat、status など大量出力になりやすいコマンドの stdout 本文を要約だけにします。"
        },
        "bazaar.trace.maxEntries": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "直近コマンド履歴としてメモリに保持する件数。"
        },
        "bazaar.trace.maxStoredOutputChars": {
          "type": "number",
          "default": 200000,
          "minimum": 0,
          "description": "直近コマンド履歴に保存する stdout/stderr の最大文字数。"
        },
        "bazaar.graph.limit": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "グラフビューで一度に読み込む Bazaar リビジョンの最大数。"
        },
        "bazaar.unknown.maxExpandedFiles": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "description": "未追跡ディレクトリをファイル項目へ展開する最大ファイル数。0 の場合はディレクトリ展開しません。"
        }
      }
    },
    "views": {
      "scm": [
        {
          "id": "bazaarExplore",
          "name": "BAZAAR EXPLORE",
          "type": "webview",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "id": "bazaarHistory",
          "name": "Bazaar 履歴",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "id": "bazaarBranches",
          "name": "Bazaar ブランチ",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "id": "bazaarTags",
          "name": "Bazaar タグ",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "id": "bazaarShelves",
          "name": "Bazaar シェルブ",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "id": "bazaarGraph",
          "name": "Bazaar グラフ",
          "type": "webview",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        }
      ]
    },
    "commands": [
      {
        "command": "bazaar.refresh",
        "title": "Bazaar: 更新",
        "icon": "$(refresh)"
      },
      {
        "command": "bazaar.explore.open",
        "title": "Bazaar: BAZAAR EXPLORE を開く",
        "icon": "$(compass)"
      },
      {
        "command": "bazaar.explore.openEditor",
        "title": "Bazaar: BAZAAR EXPLORE をエディターで開く",
        "icon": "$(open-preview)"
      },
      {
        "command": "bazaar.explore.refresh",
        "title": "Bazaar: BAZAAR EXPLORE を更新",
        "icon": "$(refresh)"
      },
      {
        "command": "bazaar.include",
        "title": "Bazaar: コミット対象に含める",
        "icon": "$(add)"
      },
      {
        "command": "bazaar.uninclude",
        "title": "Bazaar: コミット対象から外す",
        "icon": "$(remove)"
      },
      {
        "command": "bazaar.includeAll",
        "title": "Bazaar: すべてコミット対象に含める",
        "icon": "$(list-selection)"
      },
      {
        "command": "bazaar.revert",
        "title": "Bazaar: Revert",
        "icon": "$(discard)"
      },
      {
        "command": "bazaar.revertAll",
        "title": "Bazaar: すべての変更と Merge 状態を Revert",
        "icon": "$(discard)"
      },
      {
        "command": "bazaar.merge.forgetPending",
        "title": "Bazaar: Pending Merge 状態をクリア",
        "icon": "$(git-pull-request-closed)"
      },
      {
        "command": "bazaar.commit",
        "title": "Bazaar: コミット対象の変更をコミット",
        "icon": "$(check)"
      },
      {
        "command": "bazaar.pull",
        "title": "Bazaar: Pull",
        "icon": "$(cloud-download)"
      },
      {
        "command": "bazaar.push",
        "title": "Bazaar: Push",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "bazaar.resolve",
        "title": "Bazaar: 競合を解決済みにする",
        "icon": "$(check-all)"
      },
      {
        "command": "bazaar.resolveAuto",
        "title": "Bazaar: 競合を自動解決"
      },
      {
        "command": "bazaar.conflict.openMerge",
        "title": "Bazaar: 競合をマージエディターで開く",
        "icon": "$(merge)"
      },
      {
        "command": "bazaar.conflict.takeThis",
        "title": "Bazaar: こちら側を使って解決",
        "icon": "$(arrow-left)"
      },
      {
        "command": "bazaar.conflict.takeOther",
        "title": "Bazaar: 相手側を使って解決",
        "icon": "$(arrow-right)"
      },
      {
        "command": "bazaar.conflict.takeBothThisFirst",
        "title": "Bazaar: 両方を使って解決 (こちら側を先)",
        "icon": "$(arrow-up)"
      },
      {
        "command": "bazaar.conflict.takeBothThisLast",
        "title": "Bazaar: 両方を使って解決 (こちら側を後)",
        "icon": "$(arrow-down)"
      },
      {
        "command": "bazaar.conflict.resolveAll",
        "title": "Bazaar: すべての競合を解決"
      },
      {
        "command": "bazaar.cleanTree.preview",
        "title": "Bazaar: clean-tree をプレビュー",
        "icon": "$(preview)"
      },
      {
        "command": "bazaar.cleanTree.run",
        "title": "Bazaar: clean-tree を実行",
        "icon": "$(trash)"
      },
      {
        "command": "bazaar.uncommit.preview",
        "title": "Bazaar: uncommit をプレビュー",
        "icon": "$(preview)"
      },
      {
        "command": "bazaar.uncommit.run",
        "title": "Bazaar: uncommit を実行",
        "icon": "$(debug-reverse-continue)"
      },
      {
        "command": "bazaar.lock.break",
        "title": "Bazaar: ロックを解除",
        "icon": "$(unlock)"
      },
      {
        "command": "bazaar.doctor",
        "title": "Bazaar: 診断",
        "icon": "$(tools)"
      },
      {
        "command": "bazaar.openOutput",
        "title": "Bazaar: 出力を開く"
      },
      {
        "command": "bazaar.enableForWorkspace",
        "title": "Bazaar: このワークスペースで有効化",
        "icon": "$(check)"
      },
      {
        "command": "bazaar.disableForWorkspace",
        "title": "Bazaar: このワークスペースで無効化",
        "icon": "$(circle-slash)"
      },
      {
        "command": "bazaar.trace.openLast",
        "title": "Bazaar: 直近コマンドの完全出力を開く",
        "icon": "$(output)"
      },
      {
        "command": "bazaar.openResourceDiff",
        "title": "Bazaar: 変更を開く"
      },
      {
        "command": "bazaar.history.refresh",
        "title": "Bazaar: 履歴を更新",
        "icon": "$(refresh)"
      },
      {
        "command": "bazaar.history.search",
        "title": "Bazaar: 履歴を検索",
        "icon": "$(search)"
      },
      {
        "command": "bazaar.history.clearFileFilter",
        "title": "Bazaar: ファイル履歴フィルターをクリア",
        "icon": "$(clear-all)"
      },
      {
        "command": "bazaar.history.showFileHistory",
        "title": "Bazaar: ファイル履歴を表示",
        "icon": "$(history)"
      },
      {
        "command": "bazaar.history.openEditor",
        "title": "Bazaar: 履歴をエディターで開く",
        "icon": "$(open-preview)"
      },
      {
        "command": "bazaar.history.showCommit",
        "title": "Bazaar: コミットを表示"
      },
      {
        "command": "bazaar.history.showCommitDiff",
        "title": "Bazaar: コミット差分を表示",
        "icon": "$(diff)"
      },
      {
        "command": "bazaar.history.copyRevisionId",
        "title": "Bazaar: リビジョン ID をコピー",
        "icon": "$(copy)"
      },
      {
        "command": "bazaar.history.openFileAtRevision",
        "title": "Bazaar: 指定リビジョンのファイルを開く",
        "icon": "$(go-to-file)"
      },
      {
        "command": "bazaar.blame.toggle",
        "title": "Bazaar: Blame 表示を切り替え",
        "icon": "$(eye)"
      },
      {
        "command": "bazaar.blame.showCommit",
        "title": "Bazaar: Blame のコミットを表示",
        "icon": "$(git-commit)"
      },
      {
        "command": "bazaar.blame.showDiff",
        "title": "Bazaar: 行差分を開く",
        "icon": "$(diff)"
      },
      {
        "command": "bazaar.blame.openFileAtRevision",
        "title": "Bazaar: Blame のリビジョンファイルを開く",
        "icon": "$(go-to-file)"
      },
      {
        "command": "bazaar.blame.openLineChangesWithPreviousRevision",
        "title": "Bazaar: 前リビジョンとの差分を行で開く",
        "icon": "$(diff)"
      },
      {
        "command": "bazaar.blame.openLineChangesWithWorkingFile",
        "title": "Bazaar: 作業中ファイルとの差分を行で開く",
        "icon": "$(diff)"
      },
      {
        "command": "bazaar.blame.openChangesWithPreviousRevision",
        "title": "Bazaar: 前リビジョンとの差分を開く",
        "icon": "$(diff)"
      },
      {
        "command": "bazaar.blame.openChangesWithRevision",
        "title": "Bazaar: リビジョンとの差分を開く...",
        "icon": "$(diff)"
      },
      {
        "command": "bazaar.blame.openChangesWithBranchOrTag",
        "title": "Bazaar: ブランチまたはタグとの差分を開く...",
        "icon": "$(git-compare)"
      },
      {
        "command": "bazaar.blame.quickShowLineCommit",
        "title": "Bazaar: 現在行のコミットをクイック表示",
        "icon": "$(git-commit)"
      },
      {
        "command": "bazaar.blame.inspectLineCommitDetails",
        "title": "Bazaar: 現在行のコミット詳細を調査",
        "icon": "$(info)"
      },
      {
        "command": "bazaar.branch.refresh",
        "title": "Bazaar: ブランチを更新",
        "icon": "$(refresh)"
      },
      {
        "command": "bazaar.branch.create",
        "title": "Bazaar: ブランチを作成",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "bazaar.branch.switch",
        "title": "Bazaar: ブランチを切り替え、または作業ツリーを開く",
        "icon": "$(git-branch)"
      },
      {
        "command": "bazaar.branch.switchForce",
        "title": "Bazaar: ブランチを強制切替"
      },
      {
        "command": "bazaar.branch.remove",
        "title": "Bazaar: ブランチを削除",
        "icon": "$(trash)"
      },
      {
        "command": "bazaar.branch.removeForce",
        "title": "Bazaar: ブランチを強制削除"
      },
      {
        "command": "bazaar.tag.refresh",
        "title": "Bazaar: タグを更新",
        "icon": "$(refresh)"
      },
      {
        "command": "bazaar.tag.create",
        "title": "Bazaar: タグを作成",
        "icon": "$(tag-add)"
      },
      {
        "command": "bazaar.tag.delete",
        "title": "Bazaar: タグを削除",
        "icon": "$(trash)"
      },
      {
        "command": "bazaar.tag.forceMove",
        "title": "Bazaar: タグを強制移動"
      },
      {
        "command": "bazaar.shelve.refresh",
        "title": "Bazaar: シェルブを更新",
        "icon": "$(refresh)"
      },
      {
        "command": "bazaar.shelve.create",
        "title": "Bazaar: 選択ファイルをシェルブ",
        "icon": "$(archive)"
      },
      {
        "command": "bazaar.shelve.createAll",
        "title": "Bazaar: すべての変更をシェルブ",
        "icon": "$(archive)"
      },
      {
        "command": "bazaar.shelve.preview",
        "title": "Bazaar: シェルブをプレビュー",
        "icon": "$(preview)"
      },
      {
        "command": "bazaar.shelve.apply",
        "title": "Bazaar: シェルブを適用",
        "icon": "$(check)"
      },
      {
        "command": "bazaar.shelve.keep",
        "title": "Bazaar: シェルブを適用して保持",
        "icon": "$(pinned)"
      },
      {
        "command": "bazaar.shelve.delete",
        "title": "Bazaar: シェルブを削除",
        "icon": "$(trash)"
      },
      {
        "command": "bazaar.graph.open",
        "title": "Bazaar: グラフを開く",
        "icon": "$(git-merge)"
      },
      {
        "command": "bazaar.graph.openEditor",
        "title": "Bazaar: グラフをエディターで開く",
        "icon": "$(open-preview)"
      },
      {
        "command": "bazaar.graph.refresh",
        "title": "Bazaar: グラフを更新",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "bazaar.blame.toggle",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus && resourceScheme == file && bazaar.repositoryReady && bazaar.featureEnabled"
      },
      {
        "command": "bazaar.blame.quickShowLineCommit",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && resourceScheme == file && bazaar.repositoryReady && bazaar.featureEnabled"
      },
      {
        "command": "bazaar.blame.openLineChangesWithPreviousRevision",
        "key": "ctrl+alt+shift+b",
        "mac": "cmd+alt+shift+b",
        "when": "editorTextFocus && resourceScheme == file && bazaar.repositoryReady && bazaar.featureEnabled"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "bazaar.refresh",
          "group": "navigation",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.blame.toggle",
          "group": "navigation@1",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.commit",
          "group": "navigation",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.pull",
          "group": "2_sync",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.push",
          "group": "2_sync",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.includeAll",
          "group": "3_include",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.resolveAuto",
          "group": "4_conflict",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.conflict.resolveAll",
          "group": "4_conflict",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.merge.forgetPending",
          "group": "4_conflict",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.cleanTree.preview",
          "group": "5_danger",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.uncommit.preview",
          "group": "5_danger",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.doctor",
          "group": "8_diagnostics",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.openOutput",
          "group": "9_output"
        },
        {
          "command": "bazaar.disableForWorkspace",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled",
          "group": "8_diagnostics@1"
        }
      ],
      "editor/title": [
        {
          "command": "bazaar.history.showFileHistory",
          "group": "navigation",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.blame.toggle",
          "group": "navigation@0",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.blame.showCommit",
          "group": "navigation",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.blame.showDiff",
          "group": "navigation",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        },
        {
          "command": "bazaar.blame.openFileAtRevision",
          "group": "navigation",
          "when": "bazaar.repositoryReady && bazaar.featureEnabled"
        }
      ],
      "editor/context": [
        {
          "command": "bazaar.blame.openLineChangesWithPreviousRevision",
          "when": "resourceScheme == file && bazaar.repositoryReady && bazaar.featureEnabled",
          "group": "bazaar@1"
        },
        {
          "command": "bazaar.blame.openLineChangesWithWorkingFile",
          "when": "resourceScheme == file && bazaar.repositoryReady && bazaar.featureEnabled",
          "group": "bazaar@2"
        },
        {
          "command": "bazaar.blame.openChangesWithPreviousRevision",
          "when": "resourceScheme == file && bazaar.repositoryReady && bazaar.featureEnabled",
          "group": "bazaar@3"
        },
        {
          "command": "bazaar.blame.openChangesWithRevision",
          "when": "resourceScheme == file && bazaar.repositoryReady && bazaar.featureEnabled",
          "group": "bazaar@4"
        },
        {
          "command": "bazaar.blame.openChangesWithBranchOrTag",
          "when": "resourceScheme == file && bazaar.repositoryReady && bazaar.featureEnabled",
          "group": "bazaar@5"
        },
        {
          "command": "bazaar.blame.quickShowLineCommit",
          "when": "resourceScheme == file && bazaar.repositoryReady && bazaar.featureEnabled",
          "group": "bazaar@6"
        },
        {
          "command": "bazaar.blame.inspectLineCommitDetails",
